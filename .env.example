# HTTP port for the local control plane.
PORT=8787

# SQLite and local runtime data directory.
CROSSSTAFF_DATA_DIR=./data

# Command adapters execute user-configured local programs.
# Keep disabled unless you understand the security implications.
CROSSSTAFF_ALLOW_COMMANDS=0

# Optional: seed the demo workspace for screenshots or development.
CROSSSTAFF_SEED_DEMO=0

# Default command timeout in milliseconds.
CROSSSTAFF_COMMAND_TIMEOUT_MS=120000

# Provider API keys are read from the server process.
# Keep this file private and never commit .env.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
# Local placeholder for Ollama's OpenAI-compatible endpoint.
OLLAMA_API_KEY=ollama
